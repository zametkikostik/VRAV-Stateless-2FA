<?xml version="1.0" encoding="utf-8"?>
<!-- Never back up encrypted vault prefs: Keystore keys are not restored with backup. -->
<full-backup-content>
    <exclude domain="sharedpref" path="vrav_vault_storage.xml"/>
    <exclude domain="sharedpref" path="vrav_vault_storage_fallback.xml"/>
</full-backup-content>
